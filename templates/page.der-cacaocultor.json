            "text_RPEKAR": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<h1>Der Allgemeinarzt und der<br/>Neurochirurg.</h1>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
