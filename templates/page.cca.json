                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_9DnDJB": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h2>Was CCA tut</h2>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "text_color": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_G3CrTQ": {
              "type": "text",
              "settings": {
                "text": "<p>Bauern stärken. Wo es keine Verbände gibt, gründen wir welche. Wir schulen in guter landwirtschaftlicher Praxis, Bodenfruchtbarkeit, Schnitt, Ernte, Fermentation und Schädlingsmanagement – und helfen mit Vorfinanzierung vor der Saison.</p><p>&nbsp;&nbsp;&nbsp;<br/>Eine Sorte retten. Mit eigenen Baumschulen sichern wir, dass die native Sorte jeder Zone in Zeit und Raum fortbesteht. Wir lehnen jede Degradierung der Bäume, der Genetik oder der Prozesse ab.</p><p>&nbsp;&nbsp;&nbsp;<br/>Qualität standardisieren. Ernte in 50-kg-Netzsäcken, frei von Monilia und Sortenmischung. Fermentation in Holzkisten über 96 bis 120 Stunden mit Wenden. Sonnentrocknung in Etappen im Gewächshaus. Handsortierung durch die Frauen der Gemeinde. Lagerung auf Paletten mit Rückverfolgbarkeit jeder Charge.</p><p><br/>Gewinne zurückgeben. Jährliche Reinvestition in Ausbildung, Gesundheit, Transport, Sport und Ernährung der Gemeinden. Arbeit für junge Menschen, die keine Schule besuchen.</p><p>&nbsp;&nbsp;&nbsp;<br/>Kinder schützen. Dass Kinder auf der Familienfarm helfen, gehört zur ländlichen Tradition. Missbräuchliche oder erzwungene Arbeit tolerieren wir nicht – und wir wissen, dass Ecuador nur so lange nicht die Elfenbeinküste ist, wie diese Kultur gepflegt wird.</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
