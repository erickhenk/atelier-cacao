            "text_fbFKxX": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h2>Herkunft in der Tasse</h2>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
