                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_mgnF7r": {
              "type": "text",
              "settings": {
                "text": "<p>Single Origin soll der reine Ausdruck des Terroirs und der Genetik sein – von dem Ort, an dem wir den Kakao geholt haben.<br/>Das Mischen von Sorten und Röstungen dagegen erfordert Geschick und Ausprobieren: Wir haben Gleichgewichtspunkte gefunden, an denen unterschiedliche Fermentationen und Röstungen derselben Herkunft eine komplexere Tiefe ergeben. Jede unserer Trinkschokoladen ist so eine Balance – und damit die einzige ihrer Art.</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
